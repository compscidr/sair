#!/usr/bin/env bash
# sair-wifi — Turn the bench Wi-Fi on or off on locked devices mid-job.
#
# Credentials stay on the bench: the device source joins the network it is
# configured with (WIFI_SSID / WIFI_PASSPHRASE), so the job never needs them.
#
# Usage:
#   sair-wifi off                   # all locked devices drop their network
#   sair-wifi on                    # rejoin the bench Wi-Fi, wait for Internet
#   sair-wifi off --serial DEVICE_A # one device
#
# Environment variables (set by sair-acquire):
#   SAIR_LOCK_ID     Lock holding the devices
#   SAIR_PROXY_URL   Proxy HTTP API URL
#   SAIR_API_KEY     API key for authentication
#
set -euo pipefail

PROXY_URL="${SAIR_PROXY_URL:-http://localhost:8550}"
API_KEY="${SAIR_API_KEY:-dev-key-123}"
LOCK_ID="${SAIR_LOCK_ID:-}"
SERIAL=""
STATE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        on|off)
            STATE="$1"
            shift
            ;;
        --serial)
            SERIAL="$2"
            shift 2
            ;;
        --lock-id)
            LOCK_ID="$2"
            shift 2
            ;;
        --url)
            PROXY_URL="$2"
            shift 2
            ;;
        --api-key)
            API_KEY="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: sair-wifi on|off [--serial SERIAL[,SERIAL...]] [--lock-id ID] [--url URL] [--api-key KEY]" >&2
            echo "" >&2
            echo "  on    Join the bench Wi-Fi and wait until the device reaches the Internet" >&2
            echo "  off   Forget every network the shell added; the radio stays on" >&2
            echo "" >&2
            echo "Options:" >&2
            echo "  --serial SERIAL  Device(s) of the lock to change (default: all)" >&2
            echo "  --lock-id ID     Lock holding the devices (default: \$SAIR_LOCK_ID)" >&2
            echo "  --url URL        Proxy API URL (default: \$SAIR_PROXY_URL)" >&2
            echo "  --api-key KEY    API key (default: \$SAIR_API_KEY or dev-key-123)" >&2
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

if [[ -z "$STATE" ]]; then
    echo "sair-wifi: ERROR: say on or off" >&2
    exit 1
fi
if [[ -z "$LOCK_ID" ]]; then
    echo "sair-wifi: ERROR: no lock ID specified (set SAIR_LOCK_ID or use --lock-id)" >&2
    exit 1
fi

echo "sair-wifi: turning Wi-Fi ${STATE}..." >&2
CURL_ARGS=(-s -X POST -H "x-api-key: ${API_KEY}" -w '\n%{http_code}' -G
    --data-urlencode "lock_id=${LOCK_ID}" --data-urlencode "state=${STATE}")
[[ -n "$SERIAL" ]] && CURL_ARGS+=(--data-urlencode "serial=${SERIAL}")
RESPONSE=$(curl "${CURL_ARGS[@]}" "${PROXY_URL}/wifi") || {
    echo "sair-wifi: ERROR: failed to contact proxy" >&2
    exit 1
}
HTTP_STATUS=$(printf '%s\n' "$RESPONSE" | tail -n1)
BODY=$(printf '%s\n' "$RESPONSE" | sed '$d')

if [[ "$HTTP_STATUS" != "200" ]]; then
    echo "sair-wifi: ERROR: HTTP ${HTTP_STATUS}: ${BODY}" >&2
    exit 1
fi
echo "sair-wifi: Wi-Fi ${STATE}" >&2
