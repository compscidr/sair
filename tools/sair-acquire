#!/usr/bin/env bash
# sair-acquire — Acquire a device lock via the SAIR ADB proxy.
#
# The proxy handles all orchestrator communication and opens a scoped
# ADB port that only exposes the locked devices.
#
# Blocks until the requested devices are available, then prints
# environment variables to stdout for eval. On GitHub Actions (GITHUB_ENV
# set) the same variables are also appended to $GITHUB_ENV for later steps.
#
# Usage:
#   eval $(sair-acquire)                          # lock all devices
#   eval $(sair-acquire --count 1)                # lock any one free device
#   eval $(sair-acquire --count 2)                # lock any two free devices
#   eval $(sair-acquire --serial DEVICE_A)        # lock specific device
#   eval $(sair-acquire --serial DEVICE_A,DEVICE_B)  # lock multiple devices
#
# Environment variables:
#   SAIR_PROXY_URL   Proxy HTTP API URL (default: http://localhost:8550)
#   SAIR_API_KEY     API key for authentication (default: dev-key-123)
#   On GitHub Actions the repo (GITHUB_REPOSITORY) and a link to the run are
#   sent along automatically so the orchestrator can show them per job.
#
# After eval, these are exported:
#   SAIR_LOCK_ID              Lock ID for releasing later
#   SAIR_SERIALS              Comma-separated list of all acquired serials
#   SAIR_PROXY_URL            Proxy URL (for sair-release)
#   ANDROID_ADB_SERVER_PORT   Scoped ADB port (stock adb binary reads this)
#   ANDROID_SERIAL            First serial (only when single device acquired)
#   ANDROID_HOME / ANDROID_SDK_ROOT
#                             Shadow SDK whose platform-tools/adb has the
#                             scoped port baked in (only when an SDK is set).
#                             AGP 9.4+ shells out to adb from a Gradle worker
#                             daemon with an empty environment, so the port
#                             cannot be passed through the environment there.
#                             It lives under $RUNNER_TEMP (or $TMPDIR) and is
#                             left in place: later steps still use it.
#
set -euo pipefail

PROXY_URL="${SAIR_PROXY_URL:-http://localhost:8550}"
API_KEY="${SAIR_API_KEY:-dev-key-123}"
SERIAL=""
COUNT=""
REPO="${GITHUB_REPOSITORY:-}"
RUN_URL=""
if [[ -n "${GITHUB_SERVER_URL:-}" && -n "${GITHUB_REPOSITORY:-}" && -n "${GITHUB_RUN_ID:-}" ]]; then
    RUN_URL="${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}"
    [[ -n "${GITHUB_RUN_ATTEMPT:-}" ]] && RUN_URL="${RUN_URL}/attempts/${GITHUB_RUN_ATTEMPT}"
fi

# Parse flags
while [[ $# -gt 0 ]]; do
    case "$1" in
        --serial)
            SERIAL="$2"
            shift 2
            ;;
        --count)
            COUNT="$2"
            shift 2
            ;;
        --url)
            PROXY_URL="$2"
            shift 2
            ;;
        --api-key)
            API_KEY="$2"
            shift 2
            ;;
        --repo)
            REPO="$2"
            shift 2
            ;;
        --run-url)
            RUN_URL="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: eval \$(sair-acquire [--serial SERIAL[,SERIAL...]] [--count N] [--url URL] [--api-key KEY] [--repo OWNER/NAME] [--run-url URL])" >&2
            echo "" >&2
            echo "Acquires a device lock via the SAIR ADB proxy." >&2
            echo "Blocks until devices are available." >&2
            echo "" >&2
            echo "Options:" >&2
            echo "  --serial SERIAL   Specific device(s) to lock (comma-separated, default: all)" >&2
            echo "  --count N         Lock any N free devices (mutually exclusive with --serial)" >&2
            echo "  --url URL         Proxy API URL (default: \$SAIR_PROXY_URL or http://localhost:8550)" >&2
            echo "  --api-key KEY     API key (default: \$SAIR_API_KEY or dev-key-123)" >&2
            echo "  --repo OWNER/NAME Repository shown on the job (default: \$GITHUB_REPOSITORY)" >&2
            echo "  --run-url URL     Link to the CI run shown on the job (default: built from GITHUB_* vars)" >&2
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

if [[ -n "$COUNT" ]]; then
    if [[ -n "$SERIAL" ]]; then
        echo "sair-acquire: ERROR: --count and --serial are mutually exclusive" >&2
        exit 1
    fi
    # Bounded by the wire type (int32) so oversized values fail here rather
    # than in the proxy — and so the comparisons below stay in range.
    if [[ ! "$COUNT" =~ ^[0-9]{1,10}$ ]] || [[ "$COUNT" -lt 1 || "$COUNT" -gt 2147483647 ]]; then
        echo "sair-acquire: ERROR: --count must be a positive integer no greater than 2147483647 (got '${COUNT}')" >&2
        exit 1
    fi
fi

# Build acquire URL
ACQUIRE_URL="${PROXY_URL}/acquire"

echo "sair-acquire: requesting lock from proxy at ${PROXY_URL}..." >&2
if [[ -n "$SERIAL" ]]; then
    echo "sair-acquire: devices: ${SERIAL}" >&2
elif [[ -n "$COUNT" ]]; then
    echo "sair-acquire: devices: any ${COUNT}" >&2
else
    echo "sair-acquire: devices: all" >&2
fi

# POST /acquire (blocks until available)
# Use --data-urlencode to safely encode serial (may contain ':' for TCP devices)
CURL_ARGS=(-s -X POST -H "x-api-key: ${API_KEY}" -w '\n%{http_code}' -G)
if [[ -n "$SERIAL" ]]; then
    CURL_ARGS+=(--data-urlencode "serial=${SERIAL}")
elif [[ -n "$COUNT" ]]; then
    CURL_ARGS+=(--data-urlencode "count=${COUNT}")
fi
[[ -n "$REPO" ]] && CURL_ARGS+=(--data-urlencode "repo=${REPO}")
[[ -n "$RUN_URL" ]] && CURL_ARGS+=(--data-urlencode "run_url=${RUN_URL}")
RESPONSE=$(curl "${CURL_ARGS[@]}" "${ACQUIRE_URL}") || {
    echo "sair-acquire: ERROR: failed to contact proxy" >&2
    exit 1
}

# Separate HTTP status from body
HTTP_STATUS=$(printf '%s\n' "$RESPONSE" | tail -n1)
BODY=$(printf '%s\n' "$RESPONSE" | sed '$d')

# Pulls .error out of the proxy's {"error":"..."} reply. Uses a real JSON
# parser when one is around; the sed fallback handles the plain messages the
# proxy actually sends but would stop at an escaped quote.
json_error() {
    if command -v jq >/dev/null 2>&1; then
        jq -r '.error // empty' 2>/dev/null
    elif command -v python3 >/dev/null 2>&1; then
        python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error", ""))
except Exception: pass' 2>/dev/null
    else
        sed -n 's/.*"error":"\([^"]*\)".*/\1/p'
    fi
}

# Escapes text for a GitHub Actions workflow command. The message comes from
# the server, so % and newlines must not be able to end the command or start
# another one. Property values (the title) additionally escape : and ,.
gh_escape() {
    local s="$1"
    s="${s//%/%25}"; s="${s//$'\r'/%0D}"; s="${s//$'\n'/%0A}"
    printf '%s' "$s"
}
gh_escape_prop() {
    local s; s=$(gh_escape "$1")
    s="${s//:/%3A}"; s="${s//,/%2C}"
    printf '%s' "$s"
}

if [[ "$HTTP_STATUS" -lt 200 || "$HTTP_STATUS" -ge 300 ]]; then
    MSG=$(printf '%s' "$BODY" | json_error)
    [[ -z "$MSG" ]] && MSG="${BODY:-<empty>}"
    if [[ "$HTTP_STATUS" == "429" ]]; then
        HEADLINE="plan limit reached"
    else
        HEADLINE="failed to acquire lock (HTTP ${HTTP_STATUS})"
    fi
    echo "sair-acquire: ERROR: ${HEADLINE}" >&2
    echo "sair-acquire: ${MSG}" >&2
    # On GitHub Actions also raise an annotation so the reason shows on the
    # job summary. stderr, because callers often send stdout to /dev/null.
    if [[ -n "${GITHUB_ACTIONS:-}" ]]; then
        echo "::error title=$(gh_escape_prop "sair-acquire: ${HEADLINE}")::$(gh_escape "${MSG}")" >&2
    fi
    exit 1
fi

# Parse JSON response: {"lock_id":"...","serials":[...],"port":NNN}
LOCK_ID=$(echo "$BODY" | grep -o '"lock_id":"[^"]*"' | head -1 | cut -d'"' -f4)
SERIALS=$(echo "$BODY" | grep -o '"serials":\[[^]]*\]' | head -1 | tr -d '[]"' | sed 's/serials://g')
SCOPED_PORT=$(echo "$BODY" | grep -o '"port":[0-9]*' | head -1 | cut -d':' -f2)
FIRST_SERIAL=$(echo "$SERIALS" | cut -d',' -f1)

if [[ -z "$LOCK_ID" ]]; then
    echo "sair-acquire: ERROR: no lock_id in response: ${BODY}" >&2
    exit 1
fi

if [[ -z "$SCOPED_PORT" ]]; then
    echo "sair-acquire: ERROR: no port in response: ${BODY}" >&2
    exit 1
fi

echo "sair-acquire: acquired lock ${LOCK_ID}" >&2
echo "sair-acquire: devices: ${SERIALS}" >&2
echo "sair-acquire: scoped ADB port: ${SCOPED_PORT}" >&2

# Build a shadow SDK (symlinks) whose adb wraps the real one with -P <port>.
# Prints the path, or nothing when no usable SDK is set.
make_sdk_shim() {
    local port="$1" sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}" shim f
    if [[ -z "$sdk" ]]; then
        echo "sair-acquire: ANDROID_HOME/ANDROID_SDK_ROOT not set; not creating the shadow SDK (AGP 9.4+ instrumented tests need it)" >&2
        return 0
    fi
    if [[ ! -x "$sdk/platform-tools/adb" ]]; then
        echo "sair-acquire: no executable ${sdk}/platform-tools/adb; not creating the shadow SDK" >&2
        return 0
    fi
    shim=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/sair-sdk-shim-XXXXXX") || return 0
    mkdir -p "$shim/platform-tools"
    for f in "$sdk"/*; do
        [[ "$(basename "$f")" == platform-tools ]] || ln -s "$f" "$shim/"
    done
    for f in "$sdk"/platform-tools/*; do
        [[ "$(basename "$f")" == adb ]] || ln -s "$f" "$shim/platform-tools/"
    done
    # bash shebang: %q may emit bash-only $'...' quoting for unusual paths
    printf '#!/usr/bin/env bash\nexec %q -P %q "$@"\n' "$sdk/platform-tools/adb" "$port" > "$shim/platform-tools/adb"
    chmod +x "$shim/platform-tools/adb"
    echo "$shim"
}

# Print an eval-able, shell-escaped export line; on GitHub Actions also append
# the raw value to $GITHUB_ENV so later steps see it without any re-parsing.
emit_var() {
    echo "export $1=$(printf '%q' "$2")"
    if [[ -n "${GITHUB_ENV:-}" ]]; then
        printf '%s=%s\n' "$1" "$2" >> "$GITHUB_ENV"
    fi
}

# Heartbeats are managed by the proxy — no background process needed.
emit_var SAIR_LOCK_ID "$LOCK_ID"
emit_var SAIR_SERIALS "$SERIALS"
emit_var SAIR_PROXY_URL "$PROXY_URL"
emit_var ANDROID_ADB_SERVER_PORT "$SCOPED_PORT"
# Only set ANDROID_SERIAL when a single device was requested, so that
# multi-device workflows (e.g. connectedCheck) can target all devices.
SERIAL_COUNT=$(echo "$SERIALS" | tr ',' '\n' | wc -l)
if [[ "$SERIAL_COUNT" -eq 1 ]]; then
    emit_var ANDROID_SERIAL "$FIRST_SERIAL"
fi

SDK_SHIM=$(make_sdk_shim "$SCOPED_PORT")
if [[ -n "$SDK_SHIM" ]]; then
    echo "sair-acquire: shadow SDK with scoped adb: ${SDK_SHIM}" >&2
    emit_var ANDROID_HOME "$SDK_SHIM"
    emit_var ANDROID_SDK_ROOT "$SDK_SHIM"
fi
