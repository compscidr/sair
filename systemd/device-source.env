# /etc/sair/device-source.env
# Environment variables for sair-device-source

# gRPC listen port
DEVICE_SOURCE_PORT=8080

# Port of the real ADB server (must match sair-adb-server.service)
ADB_PORT=5038

# Bench Wi-Fi. When set, locked phones join it on acquire (unless
# sair-acquire --no-wifi) and are reset on release: every shell-added
# suggestion and saved network forgotten, radio toggled. Leave WIFI_SSID
# unset to not manage Wi-Fi at all. No passphrase means an open network.
#WIFI_SSID=
#WIFI_PASSPHRASE=
# Host pinged to confirm Internet, and how long to wait for it on acquire
#WIFI_PING_HOST=8.8.8.8
#WIFI_CONNECT_TIMEOUT_SECONDS=60
